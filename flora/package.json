{
  "name": "flora",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://jsrooky.github.io/flora35",
  "description": "Flora — interactive map of plant and animal occurrence data",
  "author": "Flora35",
  "main": "electron/main.js",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@turf/turf": "^7.3.5",
    "firebase": "^12.16.0",
    "mapbox-gl": "^3.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "copy-help-docs": "node scripts/copy-help-docs.js",
    "prestart": "npm run copy-help-docs",
    "prebuild": "npm run copy-help-docs",
    "start": "node scripts/start-dev.js",
    "build": "cross-env GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy:firestore-rules": "firebase deploy --only firestore:rules",
    "import:firestore-locations": "node scripts/import-locations-to-firestore.mjs",
    "import:firestore-locations:dry-run": "node scripts/import-locations-to-firestore.mjs --dry-run",
    "import:firestore-submissions": "node scripts/import-user-submissions-to-firestore.mjs",
    "import:firestore-submissions:dry-run": "node scripts/import-user-submissions-to-firestore.mjs --dry-run",
    "import:firestore-bounds": "node scripts/import-bounds-to-firestore.mjs",
    "import:firestore-bounds:dry-run": "node scripts/import-bounds-to-firestore.mjs --dry-run",
    "generate:oopt-findings": "node scripts/generate-oopt-findings.mjs --import",
    "generate:oopt-findings:dry-run": "node scripts/generate-oopt-findings.mjs --dry-run",
    "audit:locations": "node scripts/audit-firestore-locations.mjs --dry-run",
    "audit:locations:fix-local": "node scripts/audit-firestore-locations.mjs --fix-local",
    "audit:locations:fix-firestore": "node scripts/audit-firestore-locations.mjs --fix-firestore",
    "audit:locations:fix-all": "node scripts/audit-firestore-locations.mjs --fix-local --fix-firestore",
    "electron:dev": "cross-env BROWSER=none ELECTRON_START_URL=http://127.0.0.1:3000 concurrently -k \"npm start\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "build:electron": "cross-env PUBLIC_URL=. npm run build",
    "electron:preview": "npm run build:electron && electron .",
    "electron:dist": "npm run build:electron && electron-builder --win"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.0.0",
    "wait-on": "^8.0.5",
    "worker-loader": "^3.0.8"
  }
}
