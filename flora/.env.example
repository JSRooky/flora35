# Mapbox (уже используется приложением)
REACT_APP_MAPBOX_TOKEN=

# Firebase — только для тестового модуля «Ввод данных»
# Создайте проект на https://console.firebase.google.com/
# Скопируйте этот файл в .env.local и заполните значения из настроек Web-приложения.
#
# Для GitHub Pages добавьте те же переменные как repository secrets:
# Settings → Secrets and variables → Actions → New repository secret
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=