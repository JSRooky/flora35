rules_version = '2';

// Production-правила для модулей «Ввод данных» и «ООПТ» (не задеплоены по умолчанию).
service cloud.firestore {
  match /databases/{database}/documents {
    match /findings/{findingId} {
      allow read: if true;
      allow write: if false;
    }

    match /user_submissions/{submissionId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll([
          'name_ru',
          'name_latin',
          'regnum',
          'found_year',
          'found_by',
          'coordinates',
          'source'
        ])
        && request.resource.data.source == 'flora35-test'
        && request.resource.data.coordinates is list
        && request.resource.data.coordinates.size() == 2;
      allow update, delete: if false;
    }

    // Границы ООПТ/заповедников (модуль «ООПТ») — по одной коллекции на слой
    // с именем "bounds_<layer_id>", см. BOUNDS_LAYER_DEFINITIONS
    // в src/firebase/boundsCollectionFirestore.js. Firestore не поддерживает
    // wildcard по префиксу имени коллекции, поэтому сверяем префикс через matches().
    // Данные только читаются на клиенте; импорт выполняется отдельным скриптом
    // (scripts/import-bounds-to-firestore.mjs) с сервисным аккаунтом.
    match /{collectionId}/{documentId} {
      allow read: if collectionId.matches('^bounds_.*');
      allow write: if false;
    }
  }
}
