rules_version = '2';

// Production-правила для модуля «Ввод данных» (не задеплоены по умолчанию).
service cloud.firestore {
  match /databases/{database}/documents {
    match /user_submissions/{submissionId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll([
          'name_ru',
          'name_latin',
          'regnum',
          'found_year',
          'found_by',
          'coordinates',
          'source'
        ])
        && request.resource.data.source == 'flora35-test'
        && request.resource.data.coordinates is list
        && request.resource.data.coordinates.size() == 2;
      allow update, delete: if false;
    }
  }
}
