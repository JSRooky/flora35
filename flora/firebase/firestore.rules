rules_version = '2';

// Тестовый режим Firestore (открытый доступ до 29.08.2026).
// После проверки замените на ограничения из firebase/firestore.rules.production.example
// или задеплойте production-правила с аутентификацией/модерацией.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 8, 29);
    }
  }
}
